# Settings for running the contact form locally and for the tests.
# Copy to tests/test.env. Nothing here is secret: Cloudflare's public test
# keys always pass, and MAIL_PROVIDER=log saves emails to a folder instead
# of sending them.
APP_ENV=development
CONTACT_TO_EMAIL=info@constre.com
MAIL_FROM_EMAIL=noreply@constre.com
MAIL_FROM_NAME=Constre website
MAIL_PROVIDER=log
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
FORM_SECRET=local-testing-only-0123456789abcdef0123456789abcdef
ALLOWED_ORIGINS=http://localhost:8081
RATE_LIMIT_ENABLED=true
# Emails and records land here (created automatically)
DATA_DIR=tests/.data
